            try {
                var response = await fetch('/api/leads/' + encodeURIComponent(leadId) + '/followups', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
