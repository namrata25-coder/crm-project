            <div class="info-item"><div class="lbl">MOBILE NUMBER</div><div class="val">@lead.MobileNumber</div></div>
            <div class="info-item"><div class="lbl">EMAIL</div><div class="val">@lead.Email</div></div>
            <div class="info-item"><div class="lbl">DESIGNATION</div><div class="val muted">@lead.Designation</div></div>
            <div class="info-item"><div class="lbl">LOCATION</div><div class="val muted">@lead.Location</div></div>
            <div class="info-item"><div class="lbl">LEAD SOURCE</div><div class="val muted">@lead.Source</div></div>
            <div class="info-item"><div class="lbl">LEAD STATUS</div><div class="val">@Html.Raw(StatusBadge(lead.LeadStatus))</div></div>
            <div class="info-item"><div class="lbl">ASSIGNED EMPLOYEE</div>
                <div class="val">
                    <div class="avatar-chip"><div class="initials">@Initials(lead.AssignedTo)</div><span>@lead.AssignedTo</span></div>
                </div>
            </div>
            <div class="info-item"><div class="lbl">CREATED DATE</div><div class="val muted">@lead.CreatedDate</div></div>
            <div class="info-item"><div class="lbl">FOLLOW-UP DATE</div><div class="val muted">@lead.FollowUpDate</div></div>
