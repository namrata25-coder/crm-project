        var selectedVisitImages = [];

        function clearSelectedVisitImages() {
            selectedVisitImages.forEach(function (item) {
                URL.revokeObjectURL(item.previewUrl);
            });
            selectedVisitImages = [];
            renderVisitImagePreviews();
        }

        function renderVisitImagePreviews() {
            var container = document.getElementById('addVisitImagePreview');
            if (!container) return;

            container.innerHTML = '';
            selectedVisitImages.forEach(function (item, index) {
                var tile = document.createElement('div');
                tile.style.cssText = 'width:92px;position:relative;text-align:center;';

                var image = document.createElement('img');
                image.src = item.previewUrl;
                image.alt = item.file.name;
                image.style.cssText = 'width:88px;height:72px;object-fit:cover;border-radius:6px;border:1px solid var(--line);';
                tile.appendChild(image);

                var removeButton = document.createElement('button');
                removeButton.type = 'button';
                removeButton.className = 'btn btn-outline btn-sm';
                removeButton.textContent = 'Remove';
                removeButton.style.cssText = 'margin-top:4px;padding:2px 6px;font-size:11px;';
                removeButton.setAttribute('aria-label', 'Remove ' + item.file.name);
                removeButton.addEventListener('click', function () {
                    URL.revokeObjectURL(item.previewUrl);
                    selectedVisitImages.splice(index, 1);
                    renderVisitImagePreviews();
                });
                tile.appendChild(removeButton);
                container.appendChild(tile);
            });
        }

        function addVisitImages(input) {
            var errorBanner = document.getElementById('addVisitErrorBanner');
            var validExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];
            var maxImageSize = 10 * 1024 * 1024;
            var maxTotalSize = 25 * 1024 * 1024;
            var selectionError = '';

            Array.from(input.files || []).forEach(function (file) {
                var extension = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
                if (selectedVisitImages.some(function (item) {
                    return item.file.name === file.name && item.file.size === file.size && item.file.lastModified === file.lastModified;
                })) {
                    return;
                }

                var currentTotal = selectedVisitImages.reduce(function (total, item) {
                    return total + item.file.size;
                }, 0);

                if (!validExtensions.includes(extension)) {
                    selectionError = 'Unsupported photo type. Use JPG, PNG, GIF or WEBP.';
                    return;
                }
                if (file.size > maxImageSize) {
                    selectionError = 'Each photo must be 10 MB or smaller.';
                    return;
                }
                if (selectedVisitImages.length >= 10 || currentTotal + file.size > maxTotalSize) {
                    selectionError = 'You can attach up to 10 photos with a combined size of 25 MB.';
                    return;
                }

                selectedVisitImages.push({ file: file, previewUrl: URL.createObjectURL(file) });
            });

            input.value = '';
            if (errorBanner) {
                errorBanner.textContent = selectionError;
                errorBanner.style.display = selectionError ? 'flex' : 'none';
            }
            renderVisitImagePreviews();
        }

        function getVisitImagesHtml(imagePathsJson) {
            var paths = [];
            try {
                paths = JSON.parse(imagePathsJson || '[]');
            } catch (error) {
                console.error('Could not read saved visit photos:', error);
                return '—';
            }

            if (!Array.isArray(paths) || paths.length === 0) return '—';
            return paths.map(function (path) {
                var safePath = escapeHtml(path);
                return '<a href="' + safePath + '" target="_blank" rel="noopener">' +
                    '<img src="' + safePath + '" alt="Visit photo" loading="lazy" style="width:44px;height:44px;object-fit:cover;border-radius:6px;margin-right:4px;" />' +
                    '</a>';
            }).join('');
        }

