@if (lead.Visits.Count > 0)
{
    <div class="panel">
        <div class="panel-header">
            <div>
                <h2>Visit History</h2>
                <div class="hint">Complete record of in-person visits for this lead</div>
            </div>
        </div>
        <div class="panel-body">
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Visit Date</th><th>Visit Time</th><th>Visit Location</th><th>Salesperson</th>
                            <th>Conversation</th><th>Result / Outcome</th><th>Photos</th><th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in lead.Visits)
                        {
                            <tr>
                                <td>@v.VisitDate</td>
                                <td>@v.VisitTime</td>
                                <td style="max-width:220px;">@v.VisitLocation</td>
                                <td>@v.Employee</td>
                                <td style="max-width:260px;">@v.Conversation</td>
                                <td>
                                    @{
                                        var outCls = v.Outcome switch
                                        {
                                            "Interested" => "st-qualified",
                                            "Deal Closed" => "st-won",
                                            "Not Interested" => "st-lost",
                                            _ => "st-proposalsent"
                                        };
                                    }
                                    <span class="badge-status @outCls">@v.Outcome</span>
                                </td>
                                <td>
                                    @foreach (var imagePath in VisitImagePaths(v.ImagePathsJson))
                                    {
                                        <a href="@imagePath" target="_blank" rel="noopener">
                                            <img src="@imagePath" alt="Visit photo" loading="lazy" style="width:44px;height:44px;object-fit:cover;border-radius:6px;margin-right:4px;" />
                                        </a>
                                    }
                                </td>
                                <td style="max-width:220px;">@v.Remarks</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

