@model CrmLeadManagement.Models.Lead
@using System.Globalization
@{
    var lead = Model!;
    var activeTab = ViewData["ActiveTab"] as string ?? "call";
    var activeFinanceSubTab = ViewData["ActiveFinanceSubTab"] as string ?? "quotation";
    var requirementError = TempData["RequirementError"] as string;
    var quotationError = TempData["QuotationError"] as string;
    var proposalError = TempData["ProposalError"] as string;
    var latestCall = lead.CallHistory.Count > 0 ? lead.CallHistory[^1] : null;
    var latestFollowUp = lead.FollowUps.Count > 0 ? lead.FollowUps[^1] : null;
    var latestVisit = lead.Visits.Count > 0 ? lead.Visits[^1] : null;
    (string Label, string Value)[] RequirementDimensions(params (string Label, string? Value)[] values) =>
        values.Where(value => !string.IsNullOrWhiteSpace(value.Value))
            .Select(value => (value.Label, value.Value!))
            .ToArray();
    string RequirementCurrency(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return "—";

        var normalized = raw.Trim().Replace("₹", "").Replace(",", "");
        return decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount)
            ? amount.ToString("C2", CultureInfo.GetCultureInfo("en-IN"))
            : raw;
    }
}

<div class="breadcrumb-row">
    <a asp-controller="Home" asp-action="Index">Home</a><span class="sep">/</span>
    <a asp-controller="Lead" asp-action="List">Lead List</a><span class="sep">/</span>
    <span class="current">@lead.LeadName</span>
</div>

<!-- ============ LEAD DETAILS HEADER ============ -->
<div class="page-head">
    <div class="detail-hero">
        <div class="avatar-lg">@Initials(lead.LeadName)</div>
        <div>
            <h1>@lead.LeadName</h1>
            <div class="meta">
                <span>@lead.LeadId</span><span class="sep">•</span>
                <span>@lead.CompanyName</span><span class="sep">•</span>
                @Html.Raw(StatusBadge(lead.LeadStatus))
                <span class="badge-priority pr-@(lead.Priority?.ToLower() ?? "medium")">@(lead.Priority ?? "Medium") priority</span>
            </div>
        </div>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a asp-controller="Lead" asp-action="List" class="btn btn-ghost btn-sm"><i class="bi bi-arrow-left"></i> Back to Lead List</a>
    </div>
</div>

<!-- ============ TABS: Call | Follow-up | Requirement | Assign/Re-assign | Finance | Visit ============ -->
<div class="tabs-bar" role="tablist">
    <button type="button" class="tab-btn" data-tab="call" onclick="switchLeadTab('call')">
        <i class="bi bi-telephone-fill"></i> Call
    </button>
    <button type="button" class="tab-btn" data-tab="followup" onclick="switchLeadTab('followup')">
        <i class="bi bi-calendar-check-fill"></i> Follow-up
    </button>
    <button type="button" class="tab-btn" data-tab="requirement" onclick="switchLeadTab('requirement')">
        <i class="bi bi-clipboard-check"></i> Requirement
    </button>
    <button type="button" class="tab-btn" data-tab="assign" onclick="switchLeadTab('assign')">
        <i class="bi bi-person-gear"></i> Assign / Re-assign
    </button>
    <button type="button" class="tab-btn" data-tab="finance" onclick="switchLeadTab('finance')">
        <i class="bi bi-cash-coin"></i> Finance
    </button>
    <button type="button" class="tab-btn" data-tab="visit" onclick="switchLeadTab('visit')">
        <i class="bi bi-geo-alt-fill"></i> Visit
    </button>
</div>

<!-- ============ TAB CONTENT (only one panel visible at a time) ============ -->
<div class="panel" style="margin-bottom:22px;">
    <div class="panel-body">

        <!-- ============ CALL TAB — detail + history + Add Call Detail ============ -->
        <div class="tab-panel" id="tab-call">
            <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <span>Call History Detail</span>
                <button type="button" class="btn btn-primary btn-sm" id="btnAddCallDetail" onclick="openAddCallModal()">
                    <i class="bi bi-plus-lg"></i> + Add Call Detail
                </button>
            </div>

            <div id="callSuccessAlert" class="alert-success-banner" style="display:none;margin-bottom:16px;">
                <i class="bi bi-check-circle-fill"></i>
                <span id="callSuccessMsg">Call detail saved successfully!</span>
            </div>

            <div class="empty-state" id="callEmptyState" style="@(latestCall is null ? "" : "display:none;")">
                <i class="bi bi-telephone-x"></i>
                <p>No calls logged yet for this lead.</p>
            </div>

            <div id="callLatestSummaryBox" style="@(latestCall is null ? "display:none;" : "")">
                <div class="info-grid">
                    <div class="info-item"><div class="lbl">CALL DATE</div><div class="val" id="latestCallDate">@(latestCall?.CallDate ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">CALL TIME</div><div class="val" id="latestCallTime">@(latestCall?.CallTime ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">CALL STATUS</div><div class="val" id="latestCallStatus">@Html.Raw(CallStatusBadge(latestCall?.CallStatus))</div></div>
                    <div class="info-item"><div class="lbl">DURATION</div><div class="val muted" id="latestCallDuration">@(string.IsNullOrWhiteSpace(latestCall?.Duration) ? "—" : latestCall?.Duration)</div></div>
                    <div class="info-item full"><div class="lbl">REMARKS</div><div class="val muted" id="latestCallRemarks">@(string.IsNullOrWhiteSpace(latestCall?.Notes) ? "—" : latestCall?.Notes)</div></div>
                </div>
            </div>

            <div id="callHistorySection" style="@(latestCall is null ? "display:none;" : "")">
                <div class="divider-line"></div>

                <div class="section-title">Call History</div>
                <div class="table-wrap" id="callHistoryTableWrap">
                    <table class="data-table" id="callHistoryTable">
                        <thead>
                            <tr>
                                <th>Call Date</th><th>Call Time</th><th>Call Status</th>
                                <th>Duration</th><th>Employee</th><th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="callHistoryTbody">
                            @if (lead.CallHistory.Count > 0)
                            {
                                @foreach (var c in lead.CallHistory.AsEnumerable().Reverse())
                                {
                                    <tr>
                                        <td>@c.CallDate</td>
                                        <td>@c.CallTime</td>
                                        <td>@Html.Raw(CallStatusBadge(c.CallStatus))</td>
                                        <td>@(string.IsNullOrWhiteSpace(c.Duration) ? "—" : c.Duration)</td>
                                        <td>@(string.IsNullOrWhiteSpace(c.Employee) ? (string.IsNullOrWhiteSpace(lead.AssignedTo) ? "—" : lead.AssignedTo) : c.Employee)</td>
                                        <td style="max-width:260px;">@(string.IsNullOrWhiteSpace(c.Notes) ? "—" : c.Notes)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ============ FOLLOW-UP TAB — detail + history + Add Follow-up ============ -->
        <div class="tab-panel" id="tab-followup">
            <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <span>Follow-up Detail</span>
                <button type="button" class="btn btn-primary btn-sm" id="btnAddFollowUp" onclick="openAddFollowUpModal()">
                    <i class="bi bi-plus-lg"></i> + Add Follow-up
                </button>
            </div>

            <div id="followUpSuccessAlert" class="alert-success-banner" style="display:none;margin-bottom:16px;">
                <i class="bi bi-check-circle-fill"></i>
                <span id="followUpSuccessMsg">Follow-up saved successfully!</span>
            </div>

            <div class="empty-state" id="followUpEmptyState" style="@(latestFollowUp is null ? "" : "display:none;")">
                <i class="bi bi-calendar-x"></i>
                <p>No follow-ups recorded for this lead.</p>
            </div>

            <div id="followUpLatestSummaryBox" style="@(latestFollowUp is null ? "display:none;" : "")">
                <div class="info-grid">
                    <div class="info-item"><div class="lbl">FOLLOW-UP DATE</div><div class="val" id="latestFollowUpDate">@(latestFollowUp?.FollowUpDate ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">FOLLOW-UP TIME</div><div class="val" id="latestFollowUpTime">@(latestFollowUp?.FollowUpTime ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">FOLLOW-UP TYPE</div><div class="val" id="latestFollowUpType">@(string.IsNullOrWhiteSpace(latestFollowUp?.FollowUpType) ? "Call" : latestFollowUp.FollowUpType)</div></div>
                    <div class="info-item"><div class="lbl">STATUS</div><div class="val" id="latestFollowUpStatus">@Html.Raw(FollowUpStatusBadge(latestFollowUp?.Status))</div></div>
                    <div class="info-item"><div class="lbl">NEXT FOLLOW-UP</div><div class="val" id="latestNextFollowUp">@(latestFollowUp?.NextFollowUpDate?.ToString("yyyy-MM-dd") ?? "—")</div></div>
                    <div class="info-item full"><div class="lbl">REMARKS</div><div class="val muted" id="latestFollowUpRemarks">@(string.IsNullOrWhiteSpace(latestFollowUp?.Remarks) ? "—" : latestFollowUp.Remarks)</div></div>
                </div>
            </div>

            <div id="followUpHistorySection" style="@(latestFollowUp is null ? "display:none;" : "")">
                <div class="divider-line"></div>

                <div class="section-title">Follow-up History</div>
                <div class="table-wrap" id="followUpHistoryTableWrap">
                    <table class="data-table" id="followUpHistoryTable">
                        <thead>
                            <tr>
                                <th>Follow-up Date</th>
                                <th>Follow-up Time</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Next Follow-up</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="followUpHistoryTbody">
                            @if (lead.FollowUps.Count > 0)
                            {
                                @foreach (var f in lead.FollowUps.AsEnumerable().Reverse())
                                {
                                    <tr>
                                        <td>@f.FollowUpDate</td>
                                        <td>@f.FollowUpTime</td>
                                        <td>@(string.IsNullOrWhiteSpace(f.FollowUpType) ? "Call" : f.FollowUpType)</td>
                                        <td>@Html.Raw(FollowUpStatusBadge(f.Status))</td>
                                        <td>@(f.NextFollowUpDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                        <td style="max-width:320px;">@(string.IsNullOrWhiteSpace(f.Remarks) ? "—" : f.Remarks)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ============ REQUIREMENT TAB — Add Requirement (with image) + saved list ============ -->
        <div class="tab-panel" id="tab-requirement">
            <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;">
                <span>Requirements</span>
                <button type="button" class="btn btn-primary btn-sm" onclick="startNewRequirement()">
                    <i class="bi bi-plus-lg"></i> Add Requirement
                </button>
            </div>

            @if (!string.IsNullOrEmpty(requirementError))
            {
                <div class="form-error-banner"><i class="bi bi-exclamation-triangle-fill"></i> @requirementError</div>
            }

            <div id="addRequirementForm" class="req-add-form" style="display:none;">
                <form id="requirementForm" method="post" asp-controller="Lead" asp-action="AddRequirement" enctype="multipart/form-data">
                    <input type="hidden" name="leadId" value="@lead.LeadId" />
                    <input type="hidden" id="editRequirementId" name="reqId" value="" />

                    <input type="hidden" name="itemizedRequirement" value="true" />
                    <div id="requirementFormHeading" style="font-weight:700;font-size:15px;color:var(--ink-800);margin-bottom:12px;">Basic Requirement Details</div>
                    <div class="form-grid">
                        <div class="form-field">
                            <label>Priority</label>
                            <select name="priority">
                                @foreach (var p in LookupData.Priorities)
                                {
                                    <option value="@p" selected="@(p == "Medium")">@p</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Status</label>
                            <select name="status">
                                @foreach (var s in LookupData.RequirementStatuses)
                                {
                                    <option value="@s" selected="@(s == "New")">@s</option>
                                }
                            </select>
                        </div>
                        <div class="form-field full">
                            <label>Requirement Title / Subject</label>
                            <input type="text" name="title" placeholder="e.g., UPVC Windows &amp; Doors Project" />
                        </div>
                        <div class="form-field">
                            <label>Expected Date</label>
                            <input type="date" name="expectedDate" />
                        </div>
                        <div class="form-field">
                            <label>Budget</label>
                            <input type="text" name="budget" placeholder="e.g., ₹1,50,000" />
                        </div>
                        <div class="form-field full">
                            <label>Description / Remarks</label>
                            <textarea name="description" rows="2" placeholder="General requirement overview or notes..."></textarea>
                        </div>
                    </div>

                    <div class="divider-line" style="margin:16px 0;"></div>
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:8px;">
                        <div>
                            <span style="font-weight:700;font-size:14px;color:var(--ink-800);">Item Specifications</span>
                            <span style="font-size:12px;color:var(--ink-500);margin-left:8px;">(Add individual items in table format)</span>
                            <div class="hint" style="margin-top:4px;">Category options are managed in Settings. Other item details are entered directly.</div>
                        </div>
                        <button type="button" id="addRequirementItemBtn" class="btn btn-primary btn-sm" onclick="addRequirementItem()">
                            <i class="bi bi-plus-lg"></i> Add Item
                        </button>
                    </div>
                    @if (LookupData.RequirementCategories.Count == 0)
                    {
                        <div class="form-error-banner" style="margin-bottom:12px;">No requirement categories are configured. Add a category in Settings before saving an item.</div>
                    }
                    <template id="requirementCategoryOptions">
                        @foreach (var category in LookupData.RequirementCategories)
                        {
                            <option value="@category">@category</option>
                        }
                    </template>
                    <div class="table-wrap req-table-wrap" style="overflow-x:auto;margin-bottom:18px;border:1px solid var(--line);border-radius:10px;background:#fff;">
                        <table class="data-table req-items-table" style="width:100%;min-width:1530px;border-collapse:collapse;margin:0;">
                            <thead>
                                <tr style="background:var(--ink-50,#f8fafc);border-bottom:1px solid var(--line);">
                                    <th style="width:55px;text-align:center;font-size:12px;font-weight:700;padding:10px 6px;">S.No.</th>
                                    <th style="min-width:130px;font-size:12px;font-weight:700;padding:10px 8px;">Category</th>
                                    <th style="min-width:140px;font-size:12px;font-weight:700;padding:10px 8px;">Item</th>
                                    <th style="min-width:120px;font-size:12px;font-weight:700;padding:10px 8px;">Location</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">H1</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">H2</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">H3</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">W1</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">W2</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">W3</th>
                                    <th style="min-width:125px;font-size:12px;font-weight:700;padding:10px 8px;">Types</th>
                                    <th style="min-width:115px;font-size:12px;font-weight:700;padding:10px 8px;">Topology</th>
                                    <th style="min-width:130px;font-size:12px;font-weight:700;padding:10px 8px;">Glass</th>
                                    <th style="width:110px;min-width:110px;font-size:12px;font-weight:700;padding:10px 6px;">QTY</th>
                                    <th style="min-width:120px;font-size:12px;font-weight:700;padding:10px 8px;">Area (Sq.Ft) Charge</th>
                                    <th style="min-width:120px;font-size:12px;font-weight:700;padding:10px 8px;">Amount</th>
                                    <th style="min-width:180px;font-size:12px;font-weight:700;padding:10px 8px;text-align:center;">Photo / Image</th>
                                    <th style="width:45px;text-align:center;padding:10px 4px;"></th>
                                </tr>
                            </thead>
                            <tbody id="requirementItemsTbody"></tbody>
                        </table>
                        <div id="reqItemsEmptyHint" style="padding:22px;text-align:center;color:var(--ink-400);font-size:13px;">
                            <i class="bi bi-table" style="font-size:20px;display:block;margin-bottom:6px;color:var(--ink-300);"></i>
                            No items added yet. Click <strong>"Add Item"</strong> to add item rows in table format.
                        </div>
                    </div>

                    <div class="form-actions" style="display:flex;justify-content:flex-end;gap:10px;margin-top:16px;">
                        <button type="button" class="btn btn-outline" onclick="cancelRequirementEdit()">Cancel</button>
                        <button type="submit" id="saveRequirementButton" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Requirement</button>
                    </div>
                </form>
            </div>

            <div class="divider-line"></div>

            <div class="section-title" style="justify-content:space-between;">
                <span>Saved Requirements</span>
                @if (lead.Requirements.Count > 0)
                {
                    <a asp-controller="Lead" asp-action="RequirementDocument" asp-route-id="@lead.LeadId" target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                        <i class="bi bi-file-earmark-text"></i> Full Page / Print
                    </a>
                }
            </div>
            @if (lead.Requirements.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-inbox"></i><p>No requirements added yet.</p></div>
            }
            else
            {
                var savedRequirements = lead.Requirements.AsEnumerable().Reverse().ToList();
                <div class="table-wrap" style="overflow-x:auto;">
                    <table class="data-table" style="min-width:1250px;">
                        <thead>
                            <tr>
                                <th rowspan="2" style="width:50px;">Sr. No.</th>
                                <th rowspan="2">Location</th>
                                <th rowspan="2">Window Description</th>
                                <th rowspan="2">GLASS</th>
                                <th rowspan="2">QTY</th>
                                <th colspan="2">Width (mm)</th>
                                <th colspan="2">Height (mm)</th>
                                <th rowspan="2">Area (Sq.Ft) Charge</th>
                                <th rowspan="2">Amount</th>
                            </tr>
                            <tr>
                                <th>W1 / W2 / W3</th>
                                <th>Value</th>
                                <th>H1 / H2 / H3</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < savedRequirements.Count; index++)
                            {
                                var item = savedRequirements[index];
                                var category = !string.IsNullOrWhiteSpace(item.Category) ? item.Category : (!string.IsNullOrWhiteSpace(item.RequirementType) ? item.RequirementType : "General");
                                var itemName = !string.IsNullOrWhiteSpace(item.ItemName) ? item.ItemName : item.Item;
                                var widthValues = RequirementDimensions(("W1", item.W1), ("W2", item.W2), ("W3", item.W3));
                                var heightValues = RequirementDimensions(("H1", item.H1), ("H2", item.H2), ("H3", item.H3));
                                var windowDescription = string.Join(" / ", new[] { itemName, item.Types, item.Topology }
                                    .Where(value => !string.IsNullOrWhiteSpace(value)));
                                var hasStructuredDetails = !string.IsNullOrWhiteSpace(item.Location) ||
                                                           widthValues.Length > 0 || heightValues.Length > 0 ||
                                                           !string.IsNullOrWhiteSpace(item.Types) ||
                                                           !string.IsNullOrWhiteSpace(item.Topology) ||
                                                           !string.IsNullOrWhiteSpace(item.Glass);
                                <tr>
                                    <td style="text-align:center;">
                                        <div>@(index + 1)</div>
                                        <button type="button" class="icon-btn" style="border:none;background:transparent;color:var(--brand-600);cursor:pointer;"
                                                title="Edit Requirement"
                                                onclick="editRequirementItem(this)"
                                                data-req-id="@item.Id"
                                                data-category="@category"
                                                data-item="@itemName"
                                                data-location="@item.Location"
                                                data-h1="@item.H1" data-h2="@item.H2" data-h3="@item.H3"
                                                data-w1="@item.W1" data-w2="@item.W2" data-w3="@item.W3"
                                                data-types="@item.Types" data-topology="@item.Topology" data-glass="@item.Glass"
                                                data-quantity="@item.Quantity" data-area-charge="@item.AreaCharge" data-amount="@item.Amount"
                                                data-priority="@item.Priority" data-status="@item.Status"
                                                data-expected-date="@item.ExpectedDate" data-budget="@item.Budget"
                                                data-title="@(string.IsNullOrWhiteSpace(item.Details) ? item.Title : item.Details)"
                                                data-description="@item.Remarks"
                                                data-image-count="@RequirementImagePaths(item).Count"
                                                data-image-path="@RequirementImagePaths(item).FirstOrDefault()">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <form method="post" asp-controller="Lead" asp-action="DeleteRequirement" onsubmit="return confirm('Delete this requirement?');" style="display:inline;">
                                            <input type="hidden" name="leadId" value="@lead.LeadId" />
                                            <input type="hidden" name="reqId" value="@item.Id" />
                                            <button type="submit" class="icon-btn" style="border:none;background:transparent;color:var(--danger, #ef4444);cursor:pointer;" title="Delete Requirement">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Location) ? "—" : item.Location)</td>
                                    <td>
                                        <div class="cell-primary">@(string.IsNullOrWhiteSpace(windowDescription) ? item.Title : windowDescription)</div>
                                        @if (!string.IsNullOrWhiteSpace(category))
                                        {
                                            <div class="hint">@category</div>
                                        }
                                        @if (!hasStructuredDetails && !string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="hint">@item.Description</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Budget) ||
                                             !string.IsNullOrWhiteSpace(item.ExpectedDate) ||
                                             !string.IsNullOrWhiteSpace(item.Priority) ||
                                             !string.IsNullOrWhiteSpace(item.Status))
                                        {
                                            <div class="hint">
                                                @if (!string.IsNullOrWhiteSpace(item.Priority)) { <span>@item.Priority priority</span> }
                                                @if (!string.IsNullOrWhiteSpace(item.Status)) { <span> · @item.Status</span> }
                                                @if (!string.IsNullOrWhiteSpace(item.ExpectedDate)) { <span> · Expected @item.ExpectedDate</span> }
                                                @if (!string.IsNullOrWhiteSpace(item.Budget)) { <span> · Budget @item.Budget</span> }
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Remarks))
                                        {
                                            <div class="hint">@item.Remarks</div>
                                        }
                                        @foreach (var imagePath in RequirementImagePaths(item))
                                        {
                                            if (imagePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <a href="@imagePath" target="_blank" rel="noopener" class="btn btn-outline btn-xs" title="View PDF">
                                                    <i class="bi bi-file-earmark-pdf"></i> PDF
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@imagePath" target="_blank" rel="noopener">
                                                    <img src="@imagePath" alt="Requirement attachment" loading="lazy"
                                                         style="max-width:60px;max-height:45px;margin-top:5px;border-radius:4px;border:1px solid var(--line);object-fit:cover;" />
                                                </a>
                                            }
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Glass) ? "—" : item.Glass)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Quantity) ? "1" : item.Quantity)</td>
                                    <td>
                                        @if (widthValues.Length == 0)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            @foreach (var width in widthValues)
                                            {
                                                <div>@width.Label</div>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (widthValues.Length == 0)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            @foreach (var width in widthValues)
                                            {
                                                <div>@width.Value</div>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (heightValues.Length == 0)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            @foreach (var height in heightValues)
                                            {
                                                <div>@height.Label</div>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (heightValues.Length == 0)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            @foreach (var height in heightValues)
                                            {
                                                <div>@height.Value</div>
                                            }
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.AreaCharge) ? "—" : item.AreaCharge)</td>
                                    <td class="amount-cell">@RequirementCurrency(item.Amount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- ============ ASSIGN / RE-ASSIGN TAB ============ -->
        <div class="tab-panel" id="tab-assign">
            <div class="section-title">Current Assignment</div>
            <div class="assign-current">
                <div class="avatar-chip">
                    <div class="initials">@Initials(lead.AssignedTo)</div>
                </div>
                <div>
                    <div class="lbl">CURRENTLY ASSIGNED TO</div>
                    <div class="name">@(string.IsNullOrWhiteSpace(lead.AssignedTo) ? "Not assigned yet" : lead.AssignedTo)</div>
                </div>
            </div>

            <div class="divider-line"></div>

            <div class="section-title">Assign / Re-assign</div>
            <form method="post" asp-controller="Lead" asp-action="AssignLead">
                <input type="hidden" name="leadId" value="@lead.LeadId" />
                <div class="form-grid">
                    <div class="form-field full">
                        <label>Assigned Employee <span class="req">*</span></label>
                        <select name="assignedEmployee" required>
                            <option value="">Select employee</option>
                            @foreach (var e in LookupData.Employees)
                            {
                                @if (e == lead.AssignedTo)
                                {
                                    <option value="@e" selected>@e</option>
                                }
                                else
                                {
                                    <option value="@e">@e</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Assignment Date <span class="req">*</span></label>
                        <input type="date" name="assignmentDate" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-field"></div>
                    <div class="form-field full">
                        <label>Remarks</label>
                        <textarea name="remarks" placeholder="Reason for assignment / handover notes..."></textarea>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save / Assign</button>
                </div>
            </form>

            @if (lead.AssignmentHistory.Count > 0)
            {
                <div class="divider-line"></div>
                <div class="section-title">Assignment History</div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>Assigned Employee</th><th>Assignment Date</th><th>Remarks</th></tr></thead>
                        <tbody>
                            @foreach (var a in lead.AssignmentHistory.AsEnumerable().Reverse())
                            {
                                <tr>
                                    <td>@a.AssignedEmployee</td>
                                    <td>@a.AssignmentDate</td>
                                    <td style="max-width:320px;">@a.Remarks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- ============ FINANCE TAB — Quotation | Proposal sub-tabs ============ -->
        <div class="tab-panel" id="tab-finance">
            <div class="fin-subtabs" role="tablist">
                <button type="button" class="fin-subtab-btn" data-subtab="quotation" onclick="switchFinanceSubTab('quotation')">
                    <i class="bi bi-file-earmark-text"></i> Quotation
                </button>
                <button type="button" class="fin-subtab-btn" data-subtab="proposal" onclick="switchFinanceSubTab('proposal')">
                    <i class="bi bi-file-earmark-richtext"></i> Proposal
                </button>
            </div>

            <!-- ===== QUOTATION SUB-TAB ===== -->
            <div class="fin-subpanel" id="finsub-quotation">
                <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;">
                    <span>Quotations</span>
                    <button type="button" class="btn btn-primary btn-sm" onclick="newFinanceForm('quotation')">
                        <i class="bi bi-plus-lg"></i> New Quotation
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(quotationError))
                {
                    <div class="form-error-banner"><i class="bi bi-exclamation-triangle-fill"></i> @quotationError</div>
                }

                <div id="quotationForm" class="fin-add-form" style="display:none;">
                    <div class="fin-form-title" style="display:flex;align-items:center;justify-content:space-between;">
                        <span id="quotationFormTitle">New Quotation</span>
                        <span class="fin-number-chip" id="quotationNumberDisplay">Auto-generated on save</span>
                    </div>
                    <form method="post" asp-controller="Lead" asp-action="SaveQuotation" enctype="multipart/form-data">
                        <input type="hidden" name="leadId" value="@lead.LeadId" />
                        <input type="hidden" name="number" id="quotationEditingNumber" value="" />
                        <div class="form-grid">
                            <div class="form-field full">
                                <label>Attach PDF</label>
                                <div class="fin-attach-row">
                                    <label class="btn btn-outline btn-sm fin-attach-btn" for="quotationAttachment">
                                        <i class="bi bi-paperclip"></i> Attach PDF
                                    </label>
                                    <input type="file" name="attachment" id="quotationAttachment"
                                           accept=".pdf,application/pdf"
                                           style="display:none;" onchange="previewFinanceAttachment(this,'quotation')" />
                                    <span id="quotationAttachmentFileName" class="fin-attach-filename">No file chosen</span>
                                </div>
                                <div id="quotationCurrentAttachment" class="fin-attach-current" style="display:none;">
                                    <i class="bi bi-paperclip"></i> Current: <a href="#" id="quotationCurrentAttachmentLink" target="_blank" rel="noopener"></a>
                                    <span class="hint">(uploading a new file will replace this)</span>
                                </div>
                                <div class="hint" style="margin-top:4px;">PDF format up to 10 MB.</div>
                            </div>
                            <div class="form-field full">
                                <label>Description / Notes</label>
                                <textarea name="notes" id="quotationNotes" placeholder="Enter additional information or notes..."></textarea>
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn btn-outline" onclick="cancelFinanceForm('quotation')">Cancel</button>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Quotation</button>
                        </div>
                    </form>
                </div>

                <div class="divider-line"></div>
                <div class="section-title">Saved Quotations</div>
                @if (lead.Quotations.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-file-earmark-text"></i><p>No quotations created yet.</p></div>
                }
                else
                {
                    @foreach (var q in lead.Quotations.AsEnumerable().Reverse())
                    {
                        <div class="fin-record-card">
                            <div class="fin-record-head">
                                <div class="fin-record-main">
                                    <span class="fin-record-num">@q.Number</span>
                                    <span class="fin-record-sub">@q.Date</span>
                                    <span class="badge-status st-new">@q.Status</span>
                                    <span class="fin-record-amt">₹@q.GrandTotal</span>
                                </div>
                                <div class="fin-record-actions">
                                    <button type="button" class="fin-icon-btn" title="View" onclick="toggleFinanceDetail('quo-detail-@q.Number')"><i class="bi bi-eye"></i></button>
                                    <button type="button" class="fin-icon-btn" title="Edit" onclick="editFinanceRecord('quotation','@q.Number')"><i class="bi bi-pencil"></i></button>
                                    <form method="post" asp-controller="Lead" asp-action="DeleteQuotation" onsubmit="return confirm('Delete quotation @q.Number?')" style="display:inline;">
                                        <input type="hidden" name="leadId" value="@lead.LeadId" />
                                        <input type="hidden" name="number" value="@q.Number" />
                                        <button type="submit" class="fin-icon-btn danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                            <div class="fin-record-detail" id="quo-detail-@q.Number">
                                <div class="info-grid">
                                    <div class="info-item"><div class="lbl">PROJECT / REQUIREMENT</div><div class="val muted">@q.ProjectRequirement</div></div>
                                    <div class="info-item"><div class="lbl">VALID UNTIL</div><div class="val muted">@q.ValidUntil</div></div>
                                    <div class="info-item"><div class="lbl">DISCOUNT / TAX</div><div class="val muted">@q.Discount / @q.Tax</div></div>
                                </div>
                                @if (q.Items.Count > 0)
                                {
                                    <div class="table-wrap" style="margin-top:12px;">
                                        <table class="data-table">
                                            <thead><tr><th>Item / Service</th><th>Quantity</th><th>Rate</th><th>Amount</th></tr></thead>
                                            <tbody>
                                                @foreach (var it in q.Items)
                                                {
                                                    <tr><td>@it.ItemName</td><td>@it.Quantity</td><td>@it.Rate</td><td>@it.Amount</td></tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(q.TermsConditions))
                                {
                                    <div style="margin-top:10px;"><div class="lbl" style="font-size:11.5px;color:var(--ink-500);font-weight:600;">TERMS &amp; CONDITIONS</div><div style="font-size:13px;color:var(--ink-700);">@q.TermsConditions</div></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(q.Notes))
                                {
                                    <div style="margin-top:10px;"><div class="lbl" style="font-size:11.5px;color:var(--ink-500);font-weight:600;">NOTES</div><div style="font-size:13px;color:var(--ink-700);">@q.Notes</div></div>
                                }
                                <div style="margin-top:10px;">
                                    <div class="lbl" style="font-size:11.5px;color:var(--ink-500);font-weight:600;">ATTACHMENTS</div>
                                    @if (!string.IsNullOrWhiteSpace(q.AttachmentPath))
                                    {
                                        <div class="fin-attach-current" style="margin-top:4px;">
                                            <i class="bi bi-paperclip"></i>
                                            <a href="@q.AttachmentPath" target="_blank" rel="noopener">@q.AttachmentFileName</a>
                                            <a href="@q.AttachmentPath" download class="btn btn-soft btn-sm" style="margin-left:8px;"><i class="bi bi-download"></i> Download</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="font-size:13px;color:var(--ink-500);margin-top:4px;">No attachment</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <script type="application/json" id="quotation-json-@q.Number">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(q))</script>
                    }
                }
            </div>

            <!-- ===== PROPOSAL SUB-TAB ===== -->
            <div class="fin-subpanel" id="finsub-proposal">
                <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;">
                    <span>Proposals</span>
                    <button type="button" class="btn btn-primary btn-sm" onclick="newFinanceForm('proposal')">
                        <i class="bi bi-plus-lg"></i> New Proposal
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(proposalError))
                {
                    <div class="form-error-banner"><i class="bi bi-exclamation-triangle-fill"></i> @proposalError</div>
                }

                <div id="proposalForm" class="fin-add-form" style="display:none;">
                    <div class="fin-form-title" style="display:flex;align-items:center;justify-content:space-between;">
                        <span id="proposalFormTitle">New Proposal</span>
                        <span class="fin-number-chip" id="proposalNumberDisplay">Auto-generated on save</span>
                    </div>
                    <form method="post" asp-controller="Lead" asp-action="SaveProposal" enctype="multipart/form-data">
                        <input type="hidden" name="leadId" value="@lead.LeadId" />
                        <input type="hidden" name="number" id="proposalEditingNumber" value="" />
                        <div class="form-grid">
                            <div class="form-field full">
                                <label>Attach PDF</label>
                                <div class="fin-attach-row">
                                    <label class="btn btn-outline btn-sm fin-attach-btn" for="proposalAttachment">
                                        <i class="bi bi-paperclip"></i> Attach PDF
                                    </label>
                                    <input type="file" name="attachment" id="proposalAttachment"
                                           accept=".pdf,application/pdf"
                                           style="display:none;" onchange="previewFinanceAttachment(this,'proposal')" />
                                    <span id="proposalAttachmentFileName" class="fin-attach-filename">No file chosen</span>
                                </div>
                                <div id="proposalCurrentAttachment" class="fin-attach-current" style="display:none;">
                                    <i class="bi bi-paperclip"></i> Current: <a href="#" id="proposalCurrentAttachmentLink" target="_blank" rel="noopener"></a>
                                    <span class="hint">(uploading a new file will replace this)</span>
                                </div>
                                <div class="hint" style="margin-top:4px;">PDF format up to 10 MB.</div>
                            </div>
                            <div class="form-field full">
                                <label>Description / Notes</label>
                                <textarea name="notes" id="proposalNotes" placeholder="Enter additional information or notes..."></textarea>
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn btn-outline" onclick="cancelFinanceForm('proposal')">Cancel</button>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Proposal</button>
                        </div>
                    </form>
                </div>

                <div class="divider-line"></div>
                <div class="section-title">Saved Proposals</div>
                @if (lead.Proposals.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-file-earmark-richtext"></i><p>No proposals created yet.</p></div>
                }
                else
                {
                    @foreach (var p in lead.Proposals.AsEnumerable().Reverse())
                    {
                        <div class="fin-record-card">
                            <div class="fin-record-head">
                                <div class="fin-record-main">
                                    <span class="fin-record-num">@p.Number</span>
                                    <span class="fin-record-sub">@p.Date</span>
                                    <span class="badge-status st-new">@p.Status</span>
                                    <span style="font-weight:700;font-size:13.5px;">@p.Title</span>
                                </div>
                                <div class="fin-record-actions">
                                    <button type="button" class="fin-icon-btn" title="View" onclick="toggleFinanceDetail('pro-detail-@p.Number')"><i class="bi bi-eye"></i></button>
                                    <button type="button" class="fin-icon-btn" title="Edit" onclick="editFinanceRecord('proposal','@p.Number')"><i class="bi bi-pencil"></i></button>
                                    <form method="post" asp-controller="Lead" asp-action="DeleteProposal" onsubmit="return confirm('Delete proposal @p.Number?')" style="display:inline;">
                                        <input type="hidden" name="leadId" value="@lead.LeadId" />
                                        <input type="hidden" name="number" value="@p.Number" />
                                        <button type="submit" class="fin-icon-btn danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                            <div class="fin-record-detail" id="pro-detail-@p.Number">
                                <div class="info-grid">
                                    <div class="info-item"><div class="lbl">PROJECT / REQUIREMENT</div><div class="val muted">@p.ProjectRequirement</div></div>
                                    <div class="info-item"><div class="lbl">TIMELINE</div><div class="val muted">@p.Timeline</div></div>
                                    <div class="info-item"><div class="lbl">BUDGET</div><div class="val muted">@p.Budget</div></div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(p.ScopeOfWork))
                                {
                                    <div style="margin-top:10px;"><div class="lbl" style="font-size:11.5px;color:var(--ink-500);font-weight:600;">SCOPE OF WORK</div><div style="font-size:13px;color:var(--ink-700);">@p.ScopeOfWork</div></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <div style="margin-top:10px;"><div class="lbl" style="font-size:11.5px;color:var(--ink-500);font-weight:600;">DESCRIPTION</div><div style="font-size:13px;color:var(--ink-700);">@p.Description</div></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.Deliverables))
                                {
                                    <div style="margin-top:10px;"><div class="lbl" style="font-size:11.5px;color:var(--ink-500);font-weight:600;">DELIVERABLES</div><div style="font-size:13px;color:var(--ink-700);">@p.Deliverables</div></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.TermsConditions))
                                {
                                    <div style="margin-top:10px;"><div class="lbl" style="font-size:11.5px;color:var(--ink-500);font-weight:600;">TERMS &amp; CONDITIONS</div><div style="font-size:13px;color:var(--ink-700);">@p.TermsConditions</div></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.Notes))
                                {
                                    <div style="margin-top:10px;"><div class="lbl" style="font-size:11.5px;color:var(--ink-500);font-weight:600;">NOTES</div><div style="font-size:13px;color:var(--ink-700);">@p.Notes</div></div>
                                }
                                <div style="margin-top:10px;">
                                    <div class="lbl" style="font-size:11.5px;color:var(--ink-500);font-weight:600;">ATTACHMENTS</div>
                                    @if (!string.IsNullOrWhiteSpace(p.AttachmentPath))
                                    {
                                        <div class="fin-attach-current" style="margin-top:4px;">
                                            <i class="bi bi-paperclip"></i>
                                            <a href="@p.AttachmentPath" target="_blank" rel="noopener">@p.AttachmentFileName</a>
                                            <a href="@p.AttachmentPath" download class="btn btn-soft btn-sm" style="margin-left:8px;"><i class="bi bi-download"></i> Download</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="font-size:13px;color:var(--ink-500);margin-top:4px;">No attachment</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <script type="application/json" id="proposal-json-@p.Number">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(p))</script>
                    }
                }
            </div>
        </div>

        <!-- ============ VISIT TAB — Add Visit button + Visit History ============ -->
        <div class="tab-panel" id="tab-visit">
            <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <span>Visit Details</span>
                <button type="button" class="btn btn-primary btn-sm" id="btnAddVisit" onclick="openAddVisitModal()">
                    <i class="bi bi-plus-lg"></i> Add Visit
                </button>
            </div>

            <div id="visitSuccessAlert" class="alert-success-banner" style="display:none;margin-bottom:16px;">
                <i class="bi bi-check-circle-fill"></i>
                <span id="visitSuccessMsg">Visit detail saved successfully!</span>
            </div>

            <div class="empty-state" id="visitEmptyState" style="@(latestVisit is null ? "" : "display:none;")">
                <i class="bi bi-geo-alt"></i>
                <p>No visits recorded yet for this lead.</p>
            </div>

            <div id="visitLatestSummaryBox" style="@(latestVisit is null ? "display:none;" : "")">
                <div class="info-grid">
                    <div class="info-item"><div class="lbl">VISIT DATE</div><div class="val" id="latestVisitDate">@(latestVisit?.VisitDate ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">VISIT TIME</div><div class="val" id="latestVisitTime">@(latestVisit?.VisitTime ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">VISIT LOCATION</div><div class="val" id="latestVisitLocation">@(latestVisit?.VisitLocation ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">SALESPERSON</div><div class="val" id="latestVisitSalesperson">@(string.IsNullOrWhiteSpace(latestVisit?.Employee) ? (string.IsNullOrWhiteSpace(lead.AssignedTo) ? "—" : lead.AssignedTo) : latestVisit.Employee)</div></div>
                    <div class="info-item"><div class="lbl">RESULT / OUTCOME</div><div class="val" id="latestVisitOutcome">@Html.Raw(VisitOutcomeBadge(latestVisit?.Outcome))</div></div>
                    <div class="info-item full"><div class="lbl">CONVERSATION / DISCUSSION</div><div class="val muted" id="latestVisitConversation">@(string.IsNullOrWhiteSpace(latestVisit?.Conversation) ? "—" : latestVisit?.Conversation)</div></div>
                    <div class="info-item full"><div class="lbl">REMARKS</div><div class="val muted" id="latestVisitRemarks">@(string.IsNullOrWhiteSpace(latestVisit?.Remarks) ? "—" : latestVisit?.Remarks)</div></div>
                </div>
            </div>

            <div id="visitHistorySection" style="@(latestVisit is null ? "display:none;" : "")">
                <div class="divider-line"></div>

                <div class="section-title">Visit History</div>
                <div class="table-wrap" id="visitHistoryTableWrap">
                    <table class="data-table" id="visitHistoryTable">
                        <thead>
                            <tr>
                                <th>Visit Date</th>
                                <th>Visit Time</th>
                                <th>Visit Location</th>
                                <th>Salesperson</th>
                                <th>Conversation</th>
                                <th>Result / Outcome</th>
                                <th>Photos</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="visitHistoryTbody">
                            @if (lead.Visits.Count > 0)
                            {
                                @foreach (var v in lead.Visits.AsEnumerable().Reverse())
                                {
                                    <tr>
                                        <td>@v.VisitDate</td>
                                        <td>@v.VisitTime</td>
                                        <td style="max-width:220px;">@v.VisitLocation</td>
                                        <td>@(string.IsNullOrWhiteSpace(v.Employee) ? (string.IsNullOrWhiteSpace(lead.AssignedTo) ? "—" : lead.AssignedTo) : v.Employee)</td>
                                        <td style="max-width:260px;">@(string.IsNullOrWhiteSpace(v.Conversation) ? "—" : v.Conversation)</td>
                                        <td>@Html.Raw(VisitOutcomeBadge(v.Outcome))</td>
                                        <td>
                                            @foreach (var imagePath in VisitImagePaths(v.ImagePathsJson))
                                            {
                                                <a href="@imagePath" target="_blank" rel="noopener">
                                                    <img src="@imagePath" alt="Visit photo" loading="lazy" style="width:44px;height:44px;object-fit:cover;border-radius:6px;margin-right:4px;" />
                                                </a>
                                            }
                                        </td>
                                        <td style="max-width:220px;">@(string.IsNullOrWhiteSpace(v.Remarks) ? "—" : v.Remarks)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<datalist id="requirementList">
    @foreach (var r in lead.Requirements)
    {
        <option value="@r.Title"></option>
    }
</datalist>

<!-- ============ LEAD INFORMATION — immediately below the tab content ============ -->
<div class="panel" style="margin-bottom:22px;">
    <div class="panel-header">
        <div>
            <h2>Lead Information</h2>
            <div class="hint">Complete profile and contact details</div>
        </div>
    </div>
    <div class="panel-body">
        <div class="info-grid">
